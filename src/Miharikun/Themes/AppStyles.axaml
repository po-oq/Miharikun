<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 自前の見た目はここに置き、テーマの後ろで上書きする（どちらのテーマでも同じファイルで動くように。計画 7.8） -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    </Style>
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    </Style>
</Styles>
