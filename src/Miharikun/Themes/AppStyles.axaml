<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 自前の見た目はここに置き、テーマの後ろで上書きする（どちらのテーマでも同じファイルで動くように。計画 7.8）。
         状態・ステータス・エージェントの色の出し分けは、クラス（.running など）＋セレクタで行う（計画 7.9）。 -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}" />
    </Style>
    <!-- 部品ごとにフォントを決めるテーマ（SukiUI は独自のフォントを指定する）でも、日本語は OS のフォントで出す（計画 7.10） -->
    <Style Selector="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource UiFont}" /></Style>
    <Style Selector="Button"><Setter Property="FontFamily" Value="{DynamicResource UiFont}" /></Style>
    <Style Selector="TextBox"><Setter Property="FontFamily" Value="{DynamicResource UiFont}" /></Style>
    <Style Selector="CheckBox"><Setter Property="FontFamily" Value="{DynamicResource UiFont}" /></Style>
    <Style Selector="MenuItem"><Setter Property="FontFamily" Value="{DynamicResource UiFont}" /></Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    </Style>
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    </Style>
    <Style Selector="TextBlock.dim">
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- ふつうのボタン：地は白（ダークは暗い）、細い枠、丸み（SukiUI に近い見た目。テーマは FluentTheme。30-2） -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource CardItemBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardItemBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource CardItemSelectedBorderBrush}" />
    </Style>

    <!-- ヘッダーのタブ（ダッシュボード・ドキュメント・メモ）。既定は大きいので、本文に近い大きさにする -->
    <Style Selector="TabStripItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <!-- 状態の丸（絵文字は環境で色が変わるので、色つきの丸で示す） -->
    <Style Selector="Ellipse.dot">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource StateIdleBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.running"><Setter Property="Fill" Value="{DynamicResource StateRunningBrush}" /></Style>
    <Style Selector="Ellipse.dot.yourturn"><Setter Property="Fill" Value="{DynamicResource StateOkBrush}" /></Style>
    <Style Selector="Ellipse.dot.aborted"><Setter Property="Fill" Value="{DynamicResource StateWarnBrush}" /></Style>
    <Style Selector="Ellipse.dot.error"><Setter Property="Fill" Value="{DynamicResource StateErrorBrush}" /></Style>

    <!-- エージェントのバッジ（枠線と文字だけ。塗りつぶしのステータスのバッジと区別する） -->
    <Style Selector="Border.agent">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource StateIdleBrush}" />
    </Style>
    <Style Selector="Border.agent.cursor"><Setter Property="BorderBrush" Value="{DynamicResource AgentCursorBrush}" /></Style>
    <Style Selector="Border.agent.claude"><Setter Property="BorderBrush" Value="{DynamicResource AgentClaudeBrush}" /></Style>
    <Style Selector="Border.agent > TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource StateIdleBrush}" />
    </Style>
    <Style Selector="Border.agent.cursor > TextBlock"><Setter Property="Foreground" Value="{DynamicResource AgentCursorBrush}" /></Style>
    <Style Selector="Border.agent.claude > TextBlock"><Setter Property="Foreground" Value="{DynamicResource AgentClaudeBrush}" /></Style>

    <!-- ステータスのバッジ（カード）。塗りつぶし。未設定のときは出さない（IsVisible で） -->
    <Style Selector="Border.status">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource StateIdleBrush}" />
    </Style>
    <Style Selector="Border.status.working"><Setter Property="Background" Value="{DynamicResource StateRunningBrush}" /></Style>
    <Style Selector="Border.status.paused"><Setter Property="Background" Value="{DynamicResource StateWarnBrush}" /></Style>
    <Style Selector="Border.status.done"><Setter Property="Background" Value="{DynamicResource StateOkBrush}" /></Style>
    <Style Selector="Border.status > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BadgeTextBrush}" />
    </Style>

    <!-- 一覧のカード：枠と背景で区切る。選択中は薄い地＋太い枠（枠が太るぶん余白を減らし、選んでも中身がずれない）。
         テンプレートごと置き換えて、どのテーマでも同じ形にする（SukiUI の ListBoxItem はガラス調の枠と ✔ を持つため）。 -->
    <Style Selector="ListBox.cards ListBoxItem">
        <Setter Property="Margin" Value="0,0,12,8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Box" Background="{DynamicResource CardItemBackgroundBrush}" BorderBrush="{DynamicResource CardItemBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="8,6">
                    <ContentPresenter Name="CardContent" Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:pointerover /template/ Border#Box">
        <Setter Property="BorderBrush" Value="{DynamicResource CardItemSelectedBorderBrush}" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:selected /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource CardItemSelectedBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardItemSelectedBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="7,5" />
    </Style>

    <!-- 区切りのセクション（詳細のヘッダー・概要など） -->
    <Style Selector="Border.section">
        <Setter Property="Background" Value="{DynamicResource CardItemBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardItemBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- 絞り込みのチップ。選択中は塗りつぶし -->
    <Style Selector="CheckBox.chip">
        <Setter Property="Margin" Value="0,0,6,4" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- FluentTheme の CheckBox は最小の高さ 32 を持つので、外さないと枠が伸びて文字が上に寄る -->
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Chip" CornerRadius="12" BorderThickness="1" Padding="{TemplateBinding Padding}"
                        Background="{DynamicResource CardItemBackgroundBrush}" BorderBrush="{DynamicResource CardItemBorderBrush}">
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox.chip:pointerover /template/ Border#Chip">
        <Setter Property="BorderBrush" Value="{DynamicResource CardItemSelectedBorderBrush}" />
    </Style>
    <Style Selector="CheckBox.chip:checked /template/ Border#Chip">
        <Setter Property="Background" Value="{DynamicResource CardItemSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardItemSelectedBrush}" />
    </Style>
    <!-- 文字色は CheckBox 自身の Foreground から ContentPresenter に渡る（テンプレート側で上書きされるので、Border に付けても効かない） -->
    <Style Selector="CheckBox.chip:checked">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="CheckBox.chip:checked:pointerover">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- タイムラインのチップ：狭い幅（340px）でも、チップ 5 つと検索ボックスが 1 行に収まるよう、余白を詰める -->
    <Style Selector="CheckBox.chip.compact">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="0,0,3,0" />
    </Style>

    <!-- セクションの見出し・補足・ジャンプの行・完了チェックの印 -->
    <Style Selector="TextBlock.heading">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Button.jump">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector="Button.jump:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardItemSelectedBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.jump:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="TextBlock.check">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource StateIdleBrush}" />
    </Style>
    <Style Selector="TextBlock.check.ok"><Setter Property="Foreground" Value="{DynamicResource StateOkBrush}" /></Style>
    <Style Selector="TextBlock.check.ng"><Setter Property="Foreground" Value="{DynamicResource StateErrorBrush}" /></Style>
    <!-- 成果の開閉（Expander.plain）：枠なしの軽い見た目。見出しの行は「名前 … 件数 ⌄」、開くと左に細い線を引いた内容が出る。
         FluentTheme の Expander は内容に「上だけ無い」枠を描くので、テンプレートごと置き換える -->
    <Style Selector="Expander.plain">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <ToggleButton Name="PlainHeader" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Background="Transparent" BorderThickness="0" Padding="4,6" MinHeight="0" CornerRadius="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" />
                            <Path Name="Chevron" Grid.Column="1" Data="M 1,1.5 L 5,5.5 L 9,1.5" Stroke="{DynamicResource WindowTextBrush}"
                                  StrokeThickness="1.4" Width="10" Height="7" VerticalAlignment="Center" Margin="4,0,2,0"
                                  Stretch="None" RenderTransformOrigin="50%,50%" />
                        </Grid>
                    </ToggleButton>
                    <Border IsVisible="{TemplateBinding IsExpanded}" BorderThickness="2,0,0,0" BorderBrush="{DynamicResource CardItemBorderBrush}"
                            Margin="10,2,0,6" Padding="8,2,0,2">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Expander.plain:expanded /template/ Path#Chevron">
        <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <!-- 開いている（:checked）・押している（:pressed）ときも、地を塗らず文字色を変えない（トグルボタンの既定はアクセント色で塗る） -->
    <Style Selector="Expander.plain /template/ ToggleButton#PlainHeader:checked /template/ ContentPresenter#PART_ContentPresenter, Expander.plain /template/ ToggleButton#PlainHeader:pressed /template/ ContentPresenter#PART_ContentPresenter, Expander.plain /template/ ToggleButton#PlainHeader:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}" />
    </Style>
    <Style Selector="Expander.plain /template/ ToggleButton#PlainHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardItemSelectedBackgroundBrush}" />
    </Style>

    <!-- タイムラインの行（要件 12.4）：入力は右寄せ・返事は左寄せの吹き出し。マウスを載せるとコピーのヒントを出す -->
    <Style Selector="ListBox.timeline">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.timeline ListBoxItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="RowContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Border.trow">
        <Setter Property="Margin" Value="0,3,12,3" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.trow.input">
        <Setter Property="Background" Value="{DynamicResource TimelineInputBrush}" />
        <Setter Property="Margin" Value="24,3,12,3" />
    </Style>
    <Style Selector="Border.trow.response">
        <Setter Property="Background" Value="{DynamicResource TimelineResponseBrush}" />
        <Setter Property="Margin" Value="0,3,36,3" />
    </Style>
    <Style Selector="Border.trow.compaction"><Setter Property="Background" Value="{DynamicResource TimelineCompactionBrush}" /></Style>
    <Style Selector="Border.trow.highlighted"><Setter Property="BorderBrush" Value="{DynamicResource TimelineHighlightBrush}" /></Style>
    <Style Selector="Border.trow.truncated"><Setter Property="Cursor" Value="Hand" /></Style>
    <Style Selector="Border.trow TextBlock.body">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.trow.input TextBlock.body, Border.trow.response TextBlock.body">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- 吹き出しは、出し入れ（IsVisible）でなく透明度で切り替える。出し入れすると行の高さが変わり、長い欄では位置がずれて
         別の行にマウスが載り、またヒントが出て…と、マウスを載せただけで勝手にスクロールし続けるため -->
    <Style Selector="Border.bubble">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Background" Value="{DynamicResource CardItemSelectedBrush}" />
    </Style>
    <Style Selector="Border.bubble > TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.trow:pointerover Border.bubble"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Border.trow.copied Border.bubble"><Setter Property="Opacity" Value="1" /></Style>
    <!-- ヒントと「コピーしました」は、同じ場所に重ねて、透明度で切り替える（幅も変わらない） -->
    <Style Selector="Border.trow TextBlock.copiedtext"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="Border.trow.copied TextBlock.copiedtext"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Border.trow.copied TextBlock.hinttext"><Setter Property="Opacity" Value="0" /></Style>

    <!-- 見出しの小さいボタン（拡大・全部コピー） -->
    <Style Selector="Button.headingbtn">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- 1 つだけ選ぶチップ（エージェントの絞り込み）。ListBox で、ListBoxItem をチップの形にする -->
    <Style Selector="ListBox.chips">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem">
        <Setter Property="Margin" Value="0,0,6,4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Chip" CornerRadius="12" BorderThickness="1" Padding="9,2"
                        Background="{DynamicResource CardItemBackgroundBrush}" BorderBrush="{DynamicResource CardItemBorderBrush}">
                    <ContentPresenter Name="ChipContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:pointerover /template/ Border#Chip">
        <Setter Property="BorderBrush" Value="{DynamicResource CardItemSelectedBorderBrush}" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:selected /template/ Border#Chip">
        <Setter Property="Background" Value="{DynamicResource CardItemSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardItemSelectedBrush}" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:selected /template/ ContentPresenter#ChipContent">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ペイン（左・中央・右の地） -->
    <Style Selector="Border.pane">
        <Setter Property="Background" Value="{DynamicResource PaneBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <!-- 詳細のステータスボタン。選択中（.primary）はアクセント色 -->
    <Style Selector="Button.statusbtn">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.statusbtn.primary">
        <Setter Property="Background" Value="{DynamicResource CardItemSelectedBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.statusbtn.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardItemSelectedBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- 主なボタン（保存など）：アクセント色 -->
    <Style Selector="Button.accent">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Background" Value="{DynamicResource CardItemSelectedBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardItemSelectedBrush}" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardItemSelectedBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- タイトルの鉛筆ボタン -->
    <Style Selector="Button.pencil">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Content" Value="✏️" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
