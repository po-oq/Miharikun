<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<!-- 状態の丸・完了チェックの印 -->
    <SolidColorBrush x:Key="StateIdleBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="StateRunningBrush" Color="#0969DA" />
    <SolidColorBrush x:Key="StateOkBrush" Color="#1A7F37" />
    <SolidColorBrush x:Key="StateWarnBrush" Color="#9A6700" />
    <SolidColorBrush x:Key="StateErrorBrush" Color="#CF222E" />
    <!-- 「Hook が記録していません」の警告の帯（Issue #17） -->
    <SolidColorBrush x:Key="HookWarningBackgroundBrush" Color="#FFF4C2" />
    <SolidColorBrush x:Key="HookWarningBorderBrush" Color="#D4A72C" />
    <SolidColorBrush x:Key="HookWarningTextBrush" Color="#3B2F00" />
    <!-- カードの概要・メモ -->
    <SolidColorBrush x:Key="SummaryTextBrush" Color="#0E7A5A" />
    <SolidColorBrush x:Key="MemoBackgroundBrush" Color="#FFF1B8" />
    <SolidColorBrush x:Key="MemoTextBrush" Color="#3B2F00" />
    <!-- タイムライン -->
    <SolidColorBrush x:Key="TimelineInputBrush" Color="#CFE2FF" />
    <SolidColorBrush x:Key="TimelineResponseBrush" Color="#E2E2E8" />
    <SolidColorBrush x:Key="TimelineCompactionBrush" Color="#FCE0E0" />
    <SolidColorBrush x:Key="TimelineHighlightBrush" Color="#D97706" />
    <!-- ステータスのバッジ（塗りつぶし）の文字 -->
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#FFFFFF" />
    <!-- エージェントのバッジ（枠線と文字。カードの地の上で読める色） -->
    <SolidColorBrush x:Key="AgentCursorBrush" Color="#57606A" />
    <SolidColorBrush x:Key="AgentClaudeBrush" Color="#B35A1F" />
    <!-- 一覧のカード -->
    <SolidColorBrush x:Key="CardItemBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardItemBorderBrush" Color="#9A9AA6" />
    <!-- 選択中のカード：薄い地 + 太い枠（文字・丸の色は未選択のときと同じ前提で読める） -->
    <SolidColorBrush x:Key="CardItemSelectedBackgroundBrush" Color="#E8F1FD" />
    <SolidColorBrush x:Key="CardItemSelectedBorderBrush" Color="#0B63C5" />
    <SolidColorBrush x:Key="CardItemSelectedBrush" Color="#0B63C5" />
</ResourceDictionary>
