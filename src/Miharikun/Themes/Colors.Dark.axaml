<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<!-- ウィンドウの地と文字（テーマに任せず、自前で決める。SukiUI は ふつうの Window の地・文字の色を替えないため。30-2） -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="WindowTextBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#2B2B2B" />
    <!-- 状態の丸・完了チェックの印 -->
    <SolidColorBrush x:Key="StateIdleBrush" Color="#9AA0A6" />
    <SolidColorBrush x:Key="StateRunningBrush" Color="#4C9AFF" />
    <SolidColorBrush x:Key="StateOkBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="StateWarnBrush" Color="#D29922" />
    <SolidColorBrush x:Key="StateErrorBrush" Color="#F85149" />
    <!-- 「Hook が記録していません」の警告の帯（Issue #17） -->
    <SolidColorBrush x:Key="HookWarningBackgroundBrush" Color="#4B3A00" />
    <SolidColorBrush x:Key="HookWarningBorderBrush" Color="#9E6A03" />
    <SolidColorBrush x:Key="HookWarningTextBrush" Color="#F3E3A5" />
    <!-- カードの概要・メモ -->
    <SolidColorBrush x:Key="SummaryTextBrush" Color="#4FBF9A" />
    <SolidColorBrush x:Key="MemoBackgroundBrush" Color="#4A4325" />
    <SolidColorBrush x:Key="MemoTextBrush" Color="#F2F2F2" />
    <!-- タイムライン -->
    <SolidColorBrush x:Key="TimelineInputBrush" Color="#2F5C9E" />
    <SolidColorBrush x:Key="TimelineResponseBrush" Color="#55555C" />
    <SolidColorBrush x:Key="TimelineCompactionBrush" Color="#5A2D2D" />
    <SolidColorBrush x:Key="TimelineHighlightBrush" Color="#F59E0B" />
    <!-- ステータスのバッジ（塗りつぶし）の文字 -->
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#0B1220" />
    <!-- エージェントのバッジ（枠線と文字。カードの地の上で読める色） -->
    <SolidColorBrush x:Key="AgentCursorBrush" Color="#9AA7B5" />
    <SolidColorBrush x:Key="AgentClaudeBrush" Color="#E8955A" />
    <!-- 一覧のカード -->
    <SolidColorBrush x:Key="CardItemBackgroundBrush" Color="#363639" />
    <SolidColorBrush x:Key="CardItemBorderBrush" Color="#7A7A82" />
    <!-- 選択中のカード：濃い青の地 + 明るい太い枠 -->
    <SolidColorBrush x:Key="CardItemSelectedBackgroundBrush" Color="#1E3A5F" />
    <SolidColorBrush x:Key="CardItemSelectedBorderBrush" Color="#4C9AFF" />
    <SolidColorBrush x:Key="CardItemSelectedBrush" Color="#1F5FA8" />
</ResourceDictionary>
