<ui:FluentWindow x:Class="Miharikun.Views.DocumentSettingsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="ドキュメントの設定" Width="640" Height="520" MinWidth="480" MinHeight="360"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="ドキュメントの設定" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="ProjectText" Opacity="0.7" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1" Margin="0,8,0,4" Text="除外するフォルダ・ファイル（gitignore 形式。1 行に 1 つ）" FontWeight="SemiBold" />
            <TextBox Grid.Row="2" x:Name="IgnoreBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas" AutomationProperties.AutomationId="IgnoreBox" />
            <TextBlock Grid.Row="3" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap" FontSize="12"
                       Text="# コメント　! 除外の取り消し　末尾の / はフォルダのみ　* ? **　大文字小文字は区別しない　後ろの行が優先。除外したフォルダの中身は ! で戻せません（git と同じ）。" />

            <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
                <ui:Button DockPanel.Dock="Left" Content="既定に戻す" Click="OnResetClick" AutomationProperties.AutomationId="ResetButton" />
                <ui:Button DockPanel.Dock="Right" Content="キャンセル" IsCancel="True" Margin="8,0,0,0" />
                <ui:Button DockPanel.Dock="Right" Content="保存" Appearance="Primary" IsDefault="False" Click="OnSaveClick"
                           AutomationProperties.AutomationId="SaveButton" />
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
