<ui:FluentWindow x:Class="Miharikun.Views.AppSettingsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="設定" Width="560" Height="500" MinWidth="460" MinHeight="460"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="設定" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="実行中のまま動きがないとき、停止とみなす時間（分）" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="MinutesBox" Width="100" MaxLength="6" TextChanged="OnInputChanged"
                             AutomationProperties.AutomationId="RunningTimeoutBox" />
                    <TextBlock Text="分" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource StateErrorBrush}" AutomationProperties.AutomationId="RunningTimeoutError" />
                <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap" FontSize="12"
                           Text="「実行中」のまま新しい記録がこの時間なかったセッションを、一覧で「停止」と表示します（Claude Code には終了の記録がないため）。サブエージェントやコマンドの結果を待っている間は、停止にしません。0 で無効（既定 10 分）。保存するとすぐ反映されます。" />

                <TextBlock Text="Cursor の Hook exe の置き場所" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,20,0,0" />
                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <ui:Button DockPanel.Dock="Right" Content="既定に戻す" Margin="8,0,0,0" Click="OnResetHookDirClick"
                               AutomationProperties.AutomationId="HookDirResetButton" />
                    <ui:Button DockPanel.Dock="Right" Content="参照…" Margin="8,0,0,0" Click="OnBrowseHookDirClick"
                               AutomationProperties.AutomationId="HookDirBrowseButton" />
                    <TextBox x:Name="HookDirBox" TextChanged="OnInputChanged" AutomationProperties.AutomationId="HookDirBox" />
                </DockPanel>
                <TextBlock x:Name="HookDirErrorText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource StateErrorBrush}" AutomationProperties.AutomationId="HookDirError" />
                <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap" FontSize="12"
                           Text="会社の PC などで %LOCALAPPDATA% 配下の exe が動かないときに、C:\dev のような動くフォルダを指定します。フォルダは作りません（先に作ってください）。保存して場所が変わったら、その場所に導入し直すかを聞きます。導入し直さないと、次の起動で hooks.json の登録の場所に戻ります。記録の保存先は変わりません。" />
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
                <ui:Button DockPanel.Dock="Right" Content="キャンセル" IsCancel="True" Margin="8,0,0,0"
                           AutomationProperties.AutomationId="CancelButton" />
                <ui:Button DockPanel.Dock="Right" x:Name="SaveButton" Content="保存" Appearance="Primary" IsDefault="True" Click="OnSaveClick"
                           AutomationProperties.AutomationId="SaveButton" />
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
