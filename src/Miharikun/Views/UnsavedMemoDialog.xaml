<ui:FluentWindow x:Class="Miharikun.Views.UnsavedMemoDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Miharikun - メモ" Width="460" Height="190" MinWidth="360" MinHeight="170"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Miharikun - メモ" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="プロジェクトのメモが保存されていません。保存しますか？" TextWrapping="Wrap" VerticalAlignment="Center" />
            <DockPanel Grid.Row="1" LastChildFill="False">
                <ui:Button DockPanel.Dock="Right" Content="キャンセル" IsCancel="True" Margin="8,0,0,0"
                           AutomationProperties.AutomationId="UnsavedCancelButton" />
                <ui:Button DockPanel.Dock="Right" Content="保存しない" Margin="8,0,0,0" Click="OnDiscardClick"
                           AutomationProperties.AutomationId="UnsavedDiscardButton" />
                <ui:Button DockPanel.Dock="Right" Content="保存" Appearance="Primary" IsDefault="True" Click="OnSaveClick"
                           AutomationProperties.AutomationId="UnsavedSaveButton" />
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
