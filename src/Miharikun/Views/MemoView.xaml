<UserControl x:Class="Miharikun.Views.MemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Miharikun.Views"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <!-- 編集中だけ効く（SaveCommand の CanExecute） -->
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>

    <Border Margin="0,8,0,0" Padding="12,8" BorderThickness="1" CornerRadius="6"
            Background="{DynamicResource CardItemBackgroundBrush}" BorderBrush="{DynamicResource CardItemBorderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 上のバー。WebView2 の外に置く（WebView2 の上に WPF の要素を重ねると隠れる） -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="✎ 編集" Command="{Binding BeginEditCommand}" Padding="10,3" FontSize="12"
                               Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVis}}"
                               AutomationProperties.AutomationId="MemoEditButton" />
                    <ui:Button Content="保存" Command="{Binding SaveCommand}" Appearance="Primary" Padding="10,3" FontSize="12"
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                               AutomationProperties.AutomationId="MemoSaveButton" />
                    <ui:Button Content="キャンセル" Command="{Binding CancelCommand}" Margin="6,0,0,0" Padding="10,3" FontSize="12"
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                               AutomationProperties.AutomationId="MemoCancelButton" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="プロジェクトのメモ" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="MemoStatus" />
                    <TextBlock Text="{Binding ErrorText}" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource StateErrorBrush}" ToolTip="{Binding ErrorText}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                               AutomationProperties.AutomationId="MemoError" />
                </StackPanel>
            </DockPanel>

            <!-- プレビューと入力欄は同じ場所に置き、Visibility で入れ替える（重ねない） -->
            <Grid Grid.Row="1">
                <local:MarkdownPreview Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVis}}" />
                <TextBox x:Name="Editor" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                         AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, BIZ UDGothic, MS Gothic" FontSize="13" VerticalContentAlignment="Top"
                         AutomationProperties.AutomationId="MemoEditor" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
