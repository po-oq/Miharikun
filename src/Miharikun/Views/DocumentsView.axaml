<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Miharikun;assembly=Miharikun.Presentation"
             xmlns:vm="clr-namespace:Miharikun.ViewModels;assembly=Miharikun.Presentation"
             xmlns:views="clr-namespace:Miharikun.Views"
             xmlns:conv="clr-namespace:Miharikun.Converters"
             x:Class="Miharikun.Views.DocumentsView">
    <!-- ドキュメントタブ（要件 12.7）。DataContext は DocumentsViewModel。ツリーの展開・選択は VM と双方向 -->
    <UserControl.Styles>
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="0,8,0,0" RowDefinitions="Auto,*">
        <!-- 上段：読み直し・パスで絞り込み・件数 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" IsVisible="{Binding !IsExpanded}">
            <Button DockPanel.Dock="Left" Content="読み直し" Command="{Binding RescanCommand}" Margin="0,0,8,0"
                    ToolTip.Tip="全部を調べ直す（自動で反映されないときの保険）" AutomationProperties.AutomationId="RescanButton" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Opacity="0.7" VerticalAlignment="Center" Margin="12,0,4,0"
                       AutomationProperties.AutomationId="DocStatus" />
            <TextBox Classes="clearButton" PlaceholderText="🔍 パスで絞り込み（ファイル名・フォルダ名）"
                     Text="{Binding FilterText}" AutomationProperties.AutomationId="DocFilter" />
        </DockPanel>

        <Grid Grid.Row="1" x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- ツリー -->
            <TreeView x:Name="TreePane" Grid.Column="0" ItemsSource="{Binding TreeRoots}" AutomationProperties.AutomationId="DocTree">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="vm:FolderNodeViewModel" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Count}" Opacity="0.6" Margin="6,0,0,0" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter x:Name="Split1" Grid.Column="1" Width="8" Background="Transparent" />

            <!-- 一覧 -->
            <Grid x:Name="ListPane" Grid.Column="2" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="{Binding ListHeader}" Classes="dim" FontSize="12" Margin="4,0,0,6" />
                <ListBox Grid.Row="1" Classes="cards" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.AutomationId="DocList">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:DocumentRowViewModel">
                            <StackPanel>
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Icon, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding ModifiedText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding FolderLabel, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="md / html のファイルが見つかりません。&#10;除外の設定は ⚙ →「ドキュメントの設定…」" TextWrapping="Wrap"
                           Opacity="0.6" Margin="8,12" VerticalAlignment="Top" IsVisible="{Binding IsEmpty}"
                           AutomationProperties.AutomationId="DocEmpty" />
            </Grid>

            <GridSplitter x:Name="Split2" Grid.Column="3" Width="8" Background="Transparent" />

            <!-- 右：概要カードと内容 -->
            <Grid Grid.Column="4" RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="section" IsVisible="{Binding !IsExpanded}">
                    <StackPanel>
                        <TextBlock Text="ドキュメント概要" Classes="dim" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Text="ファイルを選ぶと概要を表示します" Opacity="0.6"
                                   IsVisible="{Binding Overview, Converter={x:Static ObjectConverters.IsNull}}" />
                        <ContentControl Content="{Binding Overview}" AutomationProperties.AutomationId="DocOverview">
                            <ContentControl.DataTemplates>
                                <DataTemplate DataType="vm:DocumentOverviewViewModel">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding RelativePath}" FontSize="11" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding MetaLine}" FontSize="11" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Classes="section" Margin="0">
                    <!-- 列：0 目次・1 区切り・2 プレビュー。プレビューは最初から列 2 に置き、動かさない（動かすと WebView が作り直される）。 -->
                    <Grid x:Name="ContentGrid" RowDefinitions="Auto,*" ColumnDefinitions="260,8,*">
                        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="既定のアプリで開く" Command="{Binding OpenExternalCommand}"
                                    IsEnabled="{Binding HasSelection}" Margin="6,0,0,0" Padding="8,2" FontSize="12"
                                    AutomationProperties.AutomationId="OpenExternalButton" />
                            <Button DockPanel.Dock="Right" Content="{x:Static app:ShellOpen.RevealButtonText}" Command="{Binding OpenFolderCommand}"
                                    IsEnabled="{Binding HasSelection}" Margin="6,0,0,0" Padding="8,2" FontSize="12"
                                    AutomationProperties.AutomationId="OpenFolderButton" />
                            <Button DockPanel.Dock="Right" Content="再読み込み" Command="{Binding ReloadPreviewCommand}"
                                    IsEnabled="{Binding HasSelection}" Margin="6,0,0,0" Padding="8,2" FontSize="12"
                                    AutomationProperties.AutomationId="ReloadPreviewButton" />
                            <Button DockPanel.Dock="Right" Content="{Binding IsExpanded, Converter={x:Static conv:BoolTextConverter.Instance}, ConverterParameter='⤢ 拡大|⤡ 戻す'}"
                                    Command="{Binding ToggleExpandedCommand}" Margin="6,0,0,0" Padding="8,2" FontSize="12"
                                    ToolTip.Tip="目次とプレビューを画面いっぱいに広げる／戻す（Esc でも戻る）"
                                    AutomationProperties.AutomationId="DocExpandButton" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="内容" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Overview.Title, StringFormat='— {0}'}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                           IsVisible="{Binding IsExpanded}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Overview.RelativePath}" FontSize="11" Opacity="0.7" Margin="8,0,0,0"
                                           IsVisible="{Binding IsExpanded}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <!-- 目次（拡大中の md だけ） -->
                        <Grid x:Name="OutlinePane" Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*" IsVisible="{Binding IsOutlineVisible}">
                            <TextBlock Grid.Row="0" Text="{Binding ProgressText}" IsVisible="{Binding HasProgress}" FontSize="12" Margin="4,0,0,6"
                                       AutomationProperties.AutomationId="DocProgress" />
                            <ListBox Grid.Row="1" x:Name="OutlineList" ItemsSource="{Binding Outline}" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Tapped="OnOutlineTapped" DoubleTapped="OnOutlineTapped" KeyDown="OnOutlineKeyDown"
                                     AutomationProperties.AutomationId="DocOutline">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:OutlineItemViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Margin="{Binding Depth, Converter={x:Static conv:DepthIndentConverter.Instance}}"
                                              ToolTip.Tip="{Binding DisplayText}">
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding TaskText}" Opacity="0.65" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="1" Text="見出しがありません" Opacity="0.6" Margin="8,4" VerticalAlignment="Top"
                                       IsVisible="{Binding IsOutlineEmpty}" AutomationProperties.AutomationId="DocOutlineEmpty" />
                        </Grid>
                        <GridSplitter x:Name="OutlineSplit" Grid.Row="1" Grid.Column="1" Width="8" Background="Transparent" IsVisible="{Binding IsOutlineVisible}" />

                        <views:MarkdownPreview Grid.Row="1" Grid.Column="2" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
