<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Miharikun.Views.UnsavedMemoDialog"
        Title="Miharikun"
        SizeToContent="WidthAndHeight" MinWidth="380"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="保存" MinWidth="80" HorizontalContentAlignment="Center" IsDefault="True" Click="OnSave" />
            <Button Content="保存しない" MinWidth="80" HorizontalContentAlignment="Center" Click="OnDiscard" />
            <Button Content="キャンセル" MinWidth="80" HorizontalContentAlignment="Center" IsCancel="True" Click="OnCancel" />
        </StackPanel>
        <TextBlock Text="メモが保存されていません。閉じる前に保存しますか？" TextWrapping="Wrap" />
    </DockPanel>
</Window>
