<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Miharikun.Converters"
             xmlns:b="clr-namespace:Miharikun.Behaviors"
             x:Class="Miharikun.Views.SessionCardView">
    <!-- 一覧のカードの中身（要件 12.2）。DataContext は SessionCardViewModel -->
    <StackPanel Margin="2,4">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Classes="dot"
                         Classes.running="{Binding State, Converter={x:Static conv:EqualsConverter.To}, ConverterParameter=Running}"
                         Classes.yourturn="{Binding State, Converter={x:Static conv:EqualsConverter.To}, ConverterParameter=YourTurn}"
                         Classes.aborted="{Binding State, Converter={x:Static conv:EqualsConverter.To}, ConverterParameter=Aborted}"
                         Classes.error="{Binding State, Converter={x:Static conv:EqualsConverter.To}, ConverterParameter=Error}" />
                <TextBlock Text="{Binding StateText}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" />
                <Border Classes="status" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Classes.working="{Binding Status, Converter={x:Static conv:EqualsConverter.To}, ConverterParameter=Working}"
                        Classes.paused="{Binding Status, Converter={x:Static conv:EqualsConverter.To}, ConverterParameter=Paused}"
                        Classes.done="{Binding Status, Converter={x:Static conv:EqualsConverter.To}, ConverterParameter=Done}">
                    <TextBlock Text="{Binding StatusText}" />
                </Border>
                <Border Classes="agent" AutomationProperties.AutomationId="AgentBadge"
                        Classes.cursor="{Binding AgentId, Converter={x:Static conv:EqualsConverter.To}, ConverterParameter=cursor}"
                        Classes.claude="{Binding AgentId, Converter={x:Static conv:EqualsConverter.To}, ConverterParameter=claude}">
                    <TextBlock Text="{Binding AgentName}" />
                </Border>
            </StackPanel>
            <Button DockPanel.Dock="Right" Classes="pencil" Command="{Binding Rename.BeginCommand}" ToolTip.Tip="名前を変える"
                    IsVisible="{Binding !Rename.IsEditing}" />
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       IsVisible="{Binding !Rename.IsEditing}" />
            <TextBox Margin="8,0,0,0" Text="{Binding Rename.Text}" IsVisible="{Binding Rename.IsEditing}"
                     AutomationProperties.AutomationId="CardRenameBox"
                     b:TextBoxBehaviors.FocusWhenVisible="True" b:TextBoxBehaviors.LostFocusCommand="{Binding Rename.CommitCommand}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding Rename.CommitCommand}" />
                    <KeyBinding Gesture="Escape" Command="{Binding Rename.CancelCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
        </DockPanel>
        <TextBlock Text="{Binding MetaLine}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,3,0,0" />
        <Border BorderThickness="3,0,0,0" BorderBrush="{DynamicResource CardItemBorderBrush}" Padding="6,0,0,0" Margin="0,4,0,0">
            <StackPanel>
                <TextBlock Text="{Binding PromptLine}" FontSize="12" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding PromptLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding ToolLine}" FontSize="12" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding ToolLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding ResponseLines}" FontSize="12" TextWrapping="Wrap" MaxHeight="36"
                           IsVisible="{Binding ResponseLines, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding SummaryLine}" FontSize="12" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource SummaryTextBrush}" Margin="0,4,0,0"
                   IsVisible="{Binding SummaryLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding MemoLine}" FontSize="12" TextWrapping="Wrap" Padding="6,2" Margin="0,4,0,0"
                   Background="{DynamicResource MemoBackgroundBrush}" Foreground="{DynamicResource MemoTextBrush}"
                   IsVisible="{Binding MemoLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
</UserControl>
