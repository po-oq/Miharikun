<UserControl x:Class="Miharikun.Views.DocumentPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- WebView2 は別ウィンドウ（HWND）なので、WPF の要素を上に重ねると隠れる。
         案内・状態の表示は、WebHost と入れ替えて（Visibility）出す。 -->
    <Grid>
        <Grid x:Name="WebHost" Visibility="Collapsed" />
        <TextBlock x:Name="MessageText" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="ファイルを選ぶと、ここに表示します" AutomationProperties.AutomationId="PreviewMessage" />
    </Grid>
</UserControl>
