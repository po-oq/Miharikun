<ui:FluentWindow x:Class="Miharikun.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Miharikun" Height="720" Width="1280"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="Miharikun" />

        <TabControl Grid.Row="1" Margin="8,0,8,8">
            <TabItem Header="ダッシュボード">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" MinWidth="240" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="340" MinWidth="240" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="8" CornerRadius="4"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <ui:TextBlock Text="セッション一覧" FontTypography="Subtitle" />
                    </Border>
                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent" />
                    <Border Grid.Column="2" Padding="8" CornerRadius="4"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <ui:TextBlock Text="セッション詳細" FontTypography="Subtitle" />
                    </Border>
                    <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Center" Background="Transparent" />
                    <Border Grid.Column="4" Padding="8" CornerRadius="4"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <ui:TextBlock Text="メモ・タイムライン" FontTypography="Subtitle" />
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="ドキュメント" />
            <TabItem Header="メモ" />
        </TabControl>
    </Grid>
</ui:FluentWindow>