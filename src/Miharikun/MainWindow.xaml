<ui:FluentWindow x:Class="Miharikun.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Miharikun.ViewModels"
                 xmlns:b="clr-namespace:Miharikun.Behaviors"
                 x:Name="RootWindow"
                 xmlns:sessions="clr-namespace:Miharikun.Core.Sessions;assembly=Miharikun.Core"
                 xmlns:meta="clr-namespace:Miharikun.Core.Meta;assembly=Miharikun.Core"
                 Title="Miharikun" Height="820" Width="1280"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <b:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />

        <!-- タイトルの鉛筆ボタン -->
        <Style x:Key="PencilButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Content" Value="✏️" />
            <Setter Property="ToolTip" Value="名前を変える" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 絵文字は WPF だと単色になるので、状態は色つきの丸で示す。DataContext に State があれば使える。 -->
        <Style x:Key="StateDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource StateIdleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static sessions:SessionState.Running}">
                    <Setter Property="Fill" Value="{DynamicResource StateRunningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static sessions:SessionState.YourTurn}">
                    <Setter Property="Fill" Value="{DynamicResource StateOkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static sessions:SessionState.Aborted}">
                    <Setter Property="Fill" Value="{DynamicResource StateWarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static sessions:SessionState.Error}">
                    <Setter Property="Fill" Value="{DynamicResource StateErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ステータスのバッジ（カード）。未設定のときは出さない。色は枠で示す -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource StateIdleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static meta:SessionStatus.Working}"><Setter Property="BorderBrush" Value="{DynamicResource StateRunningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static meta:SessionStatus.Paused}"><Setter Property="BorderBrush" Value="{DynamicResource StateWarnBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static meta:SessionStatus.Done}"><Setter Property="BorderBrush" Value="{DynamicResource StateOkBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 絞り込みタブ（1つだけ選ぶ）。チップの見た目 -->
        <Style x:Key="StatusTabItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" CornerRadius="11" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource CardItemBackgroundBrush}" BorderBrush="{DynamicResource CardItemBorderBrush}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource CardItemSelectedBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource CardItemSelectedBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 絞り込みのチェック（複数選べる）。ステータスのタブと同じチップの見た目 -->
        <Style x:Key="ChipCheckBox" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Chip" CornerRadius="11" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource CardItemBackgroundBrush}" BorderBrush="{DynamicResource CardItemBorderBrush}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource CardItemSelectedBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource CardItemSelectedBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 詳細のステータスボタン。選択中は Primary にする -->
        <Style x:Key="StatusButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="64" />
        </Style>

        <!-- 空文字のときは行ごと隠す -->
        <Style x:Key="SummaryLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 一覧のカード：枠と背景で区切る。選択中はアクセント色 -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,8" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource CardItemBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardItemBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource CardItemSelectedBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CardItemSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SessionCard" DataType="{x:Type vm:SessionCardViewModel}">
            <StackPanel Margin="2,4">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource StateDot}" />
                        <TextBlock Text="{Binding StateText}" FontSize="11" Margin="4,0,0,0" />
                        <Border Style="{StaticResource StatusBadge}">
                            <TextBlock Text="{Binding StatusText}" FontSize="11" />
                        </Border>
                    </StackPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource PencilButton}"
                               Command="{Binding Rename.BeginCommand}"
                               Visibility="{Binding Rename.IsEditing, Converter={StaticResource InvBoolToVis}}" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Visibility="{Binding Rename.IsEditing, Converter={StaticResource InvBoolToVis}}" />
                    <TextBox Margin="8,0,0,0" Text="{Binding Rename.Text, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding Rename.IsEditing, Converter={StaticResource BoolToVis}}"
                             b:TextBoxBehaviors.FocusWhenVisible="True"
                             b:TextBoxBehaviors.LostFocusCommand="{Binding Rename.CommitCommand}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding Rename.CommitCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding Rename.CancelCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <TextBlock Text="{Binding MetaLine}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,3,0,0" />
                <Border BorderThickness="3,0,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Padding="6,0,0,0" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding PromptLine}" Style="{StaticResource SummaryLine}" />
                        <TextBlock Text="{Binding ToolLine}" Style="{StaticResource SummaryLine}" />
                        <TextBlock Text="{Binding ResponseLines}" Style="{StaticResource SummaryLine}"
                                   TextWrapping="Wrap" MaxHeight="36" />
                    </StackPanel>
                </Border>
                <!-- 選択中のカードは背景がアクセント色になるので、緑の字が読めなくなる。選択中は白にする -->
                <TextBlock Text="{Binding SummaryLine}" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryLine}">
                            <Setter Property="Foreground" Value="{DynamicResource SummaryTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding MemoLine}" Style="{StaticResource SummaryLine}"
                           Background="{DynamicResource MemoBackgroundBrush}" Foreground="{DynamicResource MemoTextBrush}" Padding="6,2" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="SectionBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardItemBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardItemBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- 右ペインの区切り（余白は呼び出し側で決める） -->
        <Style x:Key="PanelBox" TargetType="Border" BasedOn="{StaticResource SectionBox}">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="CheckMark" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource StateIdleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="ok"><Setter Property="Foreground" Value="{DynamicResource StateOkBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="ng"><Setter Property="Foreground" Value="{DynamicResource StateErrorBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 選択ハイライトなしの行（タイムライン用） -->
        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <!-- スクロールバーが行に重ならないよう、右を空ける -->
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TimelineRow" DataType="{x:Type vm:TimelineItemViewModel}">
            <Border x:Name="Box" Margin="0,3" Padding="8,4" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandedCommand}" />
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="{Binding TimeText}" FontSize="10" Opacity="0.6" />
                    <TextBlock x:Name="Body" Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="11" Opacity="0.8" />
                    <!-- 長い本文だけ：クリックで全文を開閉 -->
                    <TextBlock x:Name="ExpandHint" FontSize="10" Opacity="0.6" Margin="0,2,0,0" Visibility="Collapsed"
                               Text="▼ クリックで全文を表示" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static sessions:TimelineKind.Input}">
                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource TimelineInputBrush}" />
                    <Setter TargetName="Box" Property="Margin" Value="24,3,0,3" />
                    <Setter TargetName="Body" Property="FontSize" Value="12" />
                    <Setter TargetName="Body" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static sessions:TimelineKind.Response}">
                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource TimelineResponseBrush}" />
                    <Setter TargetName="Box" Property="Margin" Value="0,3,24,3" />
                    <Setter TargetName="Body" Property="FontSize" Value="12" />
                    <Setter TargetName="Body" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static sessions:TimelineKind.Compaction}">
                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource TimelineCompactionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TimelineHighlightBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTruncated}" Value="True">
                    <Setter TargetName="ExpandHint" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Box" Property="Cursor" Value="Hand" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsTruncated}" Value="True" />
                        <Condition Binding="{Binding IsExpanded}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ExpandHint" Property="Text" Value="▲ クリックで閉じる" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 3行サマリーの1行。クリックでタイムラインへジャンプ -->
        <Style x:Key="JumpRow" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="Miharikun" />

        <TabControl Grid.Row="1" Margin="8,0,8,8">
            <TabItem Header="ダッシュボード">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="⚙" ToolTip="Hook の導入・削除、テーマ" Appearance="Transparent"
                                   Padding="8,2" Click="OnMenuButtonClick" AutomationProperties.AutomationId="MenuButton">
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Hook を導入 / 再導入" Click="OnInstallHookClick" />
                                    <MenuItem Header="Hook を削除" Click="OnUninstallHookClick" />
                                    <Separator />
                                    <MenuItem Header="テーマ" SubmenuOpened="OnThemeMenuOpened">
                                        <MenuItem Header="OS に合わせる" Tag="System" Click="OnThemeClick" />
                                        <MenuItem Header="ライト" Tag="Light" Click="OnThemeClick" />
                                        <MenuItem Header="ダーク" Tag="Dark" Click="OnThemeClick" />
                                    </MenuItem>
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                        <TextBlock Text="{Binding ProjectFolder}" Opacity="0.7" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" MinWidth="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="320" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="340" MinWidth="240" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：セッション一覧 -->
                        <Border Grid.Column="0" Padding="8" CornerRadius="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                <ItemsControl ItemsSource="{Binding Counts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                                <Ellipse Style="{StaticResource StateDot}" />
                                                <TextBlock FontSize="12" Margin="4,0,0,0">
                                                    <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="{Binding Count, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- ステータス絞り込み（件数は他のフィルタに関係なく全体から数える） -->
                                <ListBox ItemsSource="{Binding StatusTabs}" SelectedValuePath="Tab"
                                         SelectedValue="{Binding StatusTab, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource StatusTabItem}"
                                         Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Padding="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         AutomationProperties.AutomationId="StatusTabs">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                </StackPanel>
                                <ui:TextBox Grid.Row="1" Margin="0,8,0,0" AutomationProperties.AutomationId="SearchBox"
                                            PlaceholderText="🔍 プロンプト・概要・メモ・変更ファイルを検索"
                                            ClearButtonEnabled="True"
                                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <WrapPanel Grid.Row="2" Margin="0,6,0,6">
                                    <CheckBox Style="{StaticResource ChipCheckBox}" Content="実行中のみ" IsChecked="{Binding RunningOnly}" />
                                    <CheckBox Style="{StaticResource ChipCheckBox}" Content="未コミットあり" IsChecked="{Binding UncommittedOnly}"
                                              IsEnabled="{Binding UncommittedFilterAvailable}" />
                                    <CheckBox Style="{StaticResource ChipCheckBox}" Content="メモあり" IsChecked="{Binding MemoOnly}"
                                              IsEnabled="{Binding MemoFilterAvailable}" />
                                </WrapPanel>
                                <ListBox x:Name="CardList" Grid.Row="3" ItemsSource="{Binding CardsView}"
                                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                                         ItemTemplate="{StaticResource SessionCard}"
                                         ItemContainerStyle="{StaticResource CardItem}"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling" />
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent" />

                        <!-- 中央：セッション詳細 -->
                        <Border Grid.Column="2" Padding="8" CornerRadius="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                                <TextBlock Text="左の一覧からセッションを選んでください" Opacity="0.6"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ScrollViewer DataContext="{Binding Detail}" VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>
                                    <StackPanel Margin="0,0,14,0">

                                        <!-- ヘッダー -->
                                        <Border Style="{StaticResource SectionBox}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Style="{StaticResource StateDot}" />
                                                        <TextBlock Text="{Binding StateText}" Margin="4,0,0,0" />
                                                    </StackPanel>
                                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource PencilButton}"
                                                               Command="{Binding Rename.BeginCommand}"
                                                               Visibility="{Binding Rename.IsEditing, Converter={StaticResource InvBoolToVis}}" />
                                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding Rename.IsEditing, Converter={StaticResource InvBoolToVis}}" />
                                                    <TextBox FontSize="16" AutomationProperties.AutomationId="DetailRenameBox"
                                                             Text="{Binding Rename.Text, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding Rename.IsEditing, Converter={StaticResource BoolToVis}}"
                                                             b:TextBoxBehaviors.FocusWhenVisible="True"
                                                             b:TextBoxBehaviors.LostFocusCommand="{Binding Rename.CommitCommand}">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Return" Command="{Binding Rename.CommitCommand}" />
                                                            <KeyBinding Key="Escape" Command="{Binding Rename.CancelCommand}" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                </DockPanel>
                                                <TextBlock Text="{Binding HeaderMeta}" Style="{StaticResource Dim}" Margin="0,4,0,0"
                                                           TextWrapping="Wrap" />
                                                <!-- ステータス：自分で決める（自動では変わらない）。選択中をもう一度押すと未設定に戻る -->
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" AutomationProperties.AutomationId="StatusButtons">
                                                    <TextBlock Text="ステータス" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.8" />
                                                    <ui:Button Content="未設定" Command="{Binding ClearStatusCommand}">
                                                        <ui:Button.Style>
                                                            <Style TargetType="ui:Button" BasedOn="{StaticResource StatusButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Null}"><Setter Property="Appearance" Value="Primary" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:Button.Style>
                                                    </ui:Button>
                                                    <ui:Button Content="作業中" Command="{Binding ToggleStatusCommand}" CommandParameter="{x:Static meta:SessionStatus.Working}">
                                                        <ui:Button.Style>
                                                            <Style TargetType="ui:Button" BasedOn="{StaticResource StatusButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static meta:SessionStatus.Working}"><Setter Property="Appearance" Value="Primary" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:Button.Style>
                                                    </ui:Button>
                                                    <ui:Button Content="中断" Command="{Binding ToggleStatusCommand}" CommandParameter="{x:Static meta:SessionStatus.Paused}">
                                                        <ui:Button.Style>
                                                            <Style TargetType="ui:Button" BasedOn="{StaticResource StatusButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static meta:SessionStatus.Paused}"><Setter Property="Appearance" Value="Primary" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:Button.Style>
                                                    </ui:Button>
                                                    <ui:Button Content="完了" Command="{Binding ToggleStatusCommand}" CommandParameter="{x:Static meta:SessionStatus.Done}">
                                                        <ui:Button.Style>
                                                            <Style TargetType="ui:Button" BasedOn="{StaticResource StatusButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static meta:SessionStatus.Done}"><Setter Property="Appearance" Value="Primary" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:Button.Style>
                                                    </ui:Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- セッション概要 -->
                                        <Border Style="{StaticResource SectionBox}">
                                            <StackPanel>
                                                <TextBlock Text="セッション概要" Style="{StaticResource SectionHeading}" />
                                                <StackPanel Visibility="{Binding IsEditingSummary, Converter={StaticResource InvBoolToVis}}">
                                                    <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SummaryInfo}" Style="{StaticResource Dim}" Margin="0,2,0,0" />
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <ui:Button Content="💬 最後の返事を概要に取り込む" Command="{Binding ImportSummaryCommand}" Margin="0,0,6,4" />
                                                        <ui:Button Content="✏️ 編集" Command="{Binding EditSummaryCommand}" Margin="0,0,6,4" />
                                                        <ui:Button Content="↩ 1つ前に戻す" Command="{Binding RevertSummaryCommand}" Margin="0,0,0,4" />
                                                    </WrapPanel>
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding IsEditingSummary, Converter={StaticResource BoolToVis}}">
                                                    <TextBox Text="{Binding SummaryDraft, UpdateSourceTrigger=PropertyChanged}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="220" Padding="11,5,20,6"
                                                             VerticalScrollBarVisibility="Auto"
                                                             b:TextBoxBehaviors.FocusWhenVisible="True" />
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <ui:Button Content="保存" Command="{Binding SaveSummaryCommand}" Appearance="Primary" Margin="0,0,6,0" />
                                                        <ui:Button Content="キャンセル" Command="{Binding CancelSummaryCommand}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- いまの状況（3行サマリー） -->
                                        <Border Style="{StaticResource SectionBox}">
                                            <StackPanel>
                                                <TextBlock Text="いまの状況" Style="{StaticResource SectionHeading}" />
                                                <ui:Button Style="{StaticResource JumpRow}" Command="{Binding JumpPromptCommand}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="📝 最後に頼んだこと" />
                                                        <TextBlock Grid.Column="1" Text="{Binding PromptLine}" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource JumpRow}" Command="{Binding JumpToolCommand}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="🔧 最後にやってたこと" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ToolLine}" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource JumpRow}" Command="{Binding JumpResponseCommand}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="💬 最後の返事" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ResponseLine}" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </ui:Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- 完了チェック -->
                                        <Border Style="{StaticResource SectionBox}">
                                            <StackPanel>
                                                <TextBlock Text="完了チェック" Style="{StaticResource SectionHeading}" />
                                                <ItemsControl ItemsSource="{Binding Checks}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                                <TextBlock Text="{Binding Mark}" Style="{StaticResource CheckMark}" />
                                                                <TextBlock Text="{Binding Text}" Margin="4,0,0,0" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="※コミット済みの判定は、このセッションで編集されたファイルだけが対象です（シェル経由の変更・他の変更は対象外）"
                                                           Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 稼働状態（コストの目安） -->
                                        <Border Style="{StaticResource SectionBox}">
                                            <StackPanel>
                                                <TextBlock Text="稼働状態（コストの目安）" Style="{StaticResource SectionHeading}" />
                                                <ItemsControl ItemsSource="{Binding Stats}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,2">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" />
                                                                <TextBlock Text="{Binding Label}" Opacity="0.8" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="※金額・トークンではなく相対比較用の目安" Style="{StaticResource Dim}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 成果 -->
                                        <Border Style="{StaticResource SectionBox}">
                                            <StackPanel>
                                                <TextBlock Text="成果" Style="{StaticResource SectionHeading}" />
                                                <Expander>
                                                    <Expander.Header>
                                                        <DockPanel Width="440">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CommitsText}" />
                                                            <TextBlock Text="コミット" Opacity="0.8" />
                                                        </DockPanel>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding Commits}" Margin="8,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                                <Expander Margin="0,4,0,0">
                                                    <Expander.Header>
                                                        <DockPanel Width="440">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ChangedFilesText}" />
                                                            <TextBlock Text="変更したファイル" Opacity="0.8" />
                                                        </DockPanel>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding ChangedFiles}" Margin="8,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                                <Expander Margin="0,4,0,0">
                                                    <Expander.Header>
                                                        <DockPanel Width="440">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TestRunsText}" />
                                                            <TextBlock Text="テスト実行" Opacity="0.8" />
                                                        </DockPanel>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding TestRuns}" Margin="8,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,6">
                                                                    <TextBlock FontSize="12">
                                                                        <Run Text="{Binding Command, Mode=OneWay}" FontFamily="Consolas" />
                                                                        <Run Text="  " /><Run Text="{Binding Result, Mode=OneWay}" />
                                                                        <Run Text="・" /><Run Text="{Binding Duration, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding OutputTail}" FontFamily="Consolas" FontSize="10"
                                                                               Opacity="0.7" MaxHeight="90" TextTrimming="CharacterEllipsis"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </StackPanel>
                                        </Border>

                                        <!-- ターン一覧 -->
                                        <Border Style="{StaticResource SectionBox}">
                                            <StackPanel>
                                                <TextBlock Text="ターン一覧" Style="{StaticResource SectionHeading}" />
                                                <ItemsControl ItemsSource="{Binding Turns}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ui:Button Style="{StaticResource JumpRow}" Command="{Binding JumpCommand}">
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Header}" Width="150" Opacity="0.8" />
                                                                    <TextBlock Text="{Binding Prompt}" TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                            </ui:Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Center" Background="Transparent" />

                        <!-- 右：タイムライン -->
                        <Border Grid.Column="4" Padding="8" CornerRadius="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="160" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="150" MinHeight="60" />
                                </Grid.RowDefinitions>

                                <!-- メモ：入力するたびにメモリへ、フォーカスアウトでファイルへ保存 -->
                                <Border Grid.Row="0" Style="{StaticResource PanelBox}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="メモ" Style="{StaticResource SectionHeading}" />
                                    <ui:TextBox x:Name="MemoBox" AutomationProperties.AutomationId="MemoBox" Text="{Binding Detail.MemoText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="160" Padding="11,5,20,6"
                                             VerticalScrollBarVisibility="Auto"
                                             PlaceholderText="放置した理由・続きの予定など"
                                             b:TextBoxBehaviors.LostFocusCommand="{Binding Detail.SaveMemoCommand}">
                                        <ui:TextBox.Style>
                                            <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBox.Style>
                                    </ui:TextBox>
                                </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.RowSpan="3" Style="{StaticResource PanelBox}" />
                                <TextBlock Grid.Row="1" Text="タイムライン" Style="{StaticResource SectionHeading}" Margin="10,10,10,6" />
                                <WrapPanel Grid.Row="2" Margin="10,0,10,2">
                                    <CheckBox Style="{StaticResource ChipCheckBox}" Content="入力" IsChecked="{Binding Timeline.ShowInput}" />
                                    <CheckBox Style="{StaticResource ChipCheckBox}" Content="返事" IsChecked="{Binding Timeline.ShowResponse}" />
                                    <CheckBox Style="{StaticResource ChipCheckBox}" Content="思考" IsChecked="{Binding Timeline.ShowThought}" />
                                    <CheckBox Style="{StaticResource ChipCheckBox}" Content="ツール" IsChecked="{Binding Timeline.ShowTool}" />
                                    <CheckBox Style="{StaticResource ChipCheckBox}" Content="圧縮" IsChecked="{Binding Timeline.ShowCompaction}" />
                                </WrapPanel>
                                <ListBox x:Name="TimelineList" Grid.Row="3" Margin="6,0,2,6" ItemsSource="{Binding Timeline.View}"
                                         ItemTemplate="{StaticResource TimelineRow}"
                                         ItemContainerStyle="{StaticResource PlainItem}"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel" />

                                <!-- 区切りをドラッグして、タイムラインと下の2つのリストの高さを調整できる -->
                                <GridSplitter Grid.Row="4" Height="8" HorizontalAlignment="Stretch" Background="Transparent"
                                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

                                <Border Grid.Row="5" Style="{StaticResource PanelBox}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="最近の入力（全セッション）" Style="{StaticResource SectionHeading}" />
                                        <ItemsControl ItemsSource="{Binding RecentInputs}" Margin="0,0,0,10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:Button Style="{StaticResource JumpRow}" Padding="4,2"
                                                               Command="{Binding DataContext.SelectSessionCommand, ElementName=RootWindow}"
                                                               CommandParameter="{Binding Key}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Dim}"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </ui:Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="最近閉じたセッション" Style="{StaticResource SectionHeading}" />
                                        <ItemsControl ItemsSource="{Binding RecentClosed}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:Button Style="{StaticResource JumpRow}" Padding="4,2"
                                                               Command="{Binding DataContext.SelectSessionCommand, ElementName=RootWindow}"
                                                               CommandParameter="{Binding Key}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Dim}"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </ui:Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- MVP 対象外のタブ（タブだけ置く／後で実装） -->
            <TabItem Header="ドキュメント">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="ドキュメント" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="MVP 対象外" Margin="0,4,0,12" Opacity="0.7" HorizontalAlignment="Center" />
                    <TextBlock Text="プロジェクト配下の .md / .html をツリーで表示し、クリックで右にプレビューする機能を予定しています。"
                               TextWrapping="Wrap" Opacity="0.7" TextAlignment="Center" />
                </StackPanel>
            </TabItem>
            <TabItem Header="メモ">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="プロジェクトのメモ" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="MVP 対象外" Margin="0,4,0,12" Opacity="0.7" HorizontalAlignment="Center" />
                    <TextBlock Text="プロジェクト単位の自由メモを書ける機能を予定しています。セッションごとのメモは、ダッシュボードの右上にあります。"
                               TextWrapping="Wrap" Opacity="0.7" TextAlignment="Center" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>